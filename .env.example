# Select a server-side AI provider. The learner-facing UI stays provider-neutral.
AI_PROVIDER=deepseek

# Provider credentials and optional model overrides. Keep real keys in .env or .env.local only.
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# SQLite path relative to prisma/schema.prisma. Use file:/data/demo.db for a hosted persistent volume.
DATABASE_URL="file:../data/dev.db"

# Hosted demo only. Basic Auth is enabled only when both credentials are set.
DEMO_USER=
DEMO_PASSWORD=

# Enable only for a hosted instance that should load bundled synthetic demo records.
DEMO_SEED=0
