# AI provider. Use "openai" or "deepseek".
AI_PROVIDER=openai

# OpenAI configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# DeepSeek configuration. Keep real keys only in .env or .env.local.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# SQLite database used by Prisma. The path is relative to prisma/schema.prisma.
DATABASE_URL="file:../data/dev.db"
